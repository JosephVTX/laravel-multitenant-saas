APP_NAME="SaaS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
TENANT_CENTRAL_DOMAIN=saas.ndn.pe
TENANT_HEADER=X-Tenant
TENANT_CACHE_STORE=redis
TENANT_CACHE_TTL=3600
TENANT_CACHE_PREFIX=tenant
TENANT_PAGINATION_DEFAULT=15
TENANT_PAGINATION_MAX=100
TENANT_RATE_LIMIT=300
GUEST_RATE_LIMIT=60

AUTH_GUARD=api

# ---------------------------------------------------------------------------
# Database (MySQL 8 / PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_multitenant_saas
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Cache / Queue / Session (Redis recommended for high concurrency)
# ---------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PREFIX=

# ---------------------------------------------------------------------------
# JWT (tymon/jwt-auth)
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=30
JWT_LEEWAY=0

# ---------------------------------------------------------------------------
# Bootstrap: creates the first super admin on `php artisan migrate --seed`
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@saas.ndn.pe
SUPER_ADMIN_PASSWORD=password

# ---------------------------------------------------------------------------
# Octane (production container)
# ---------------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# ---------------------------------------------------------------------------
# Container runtime (Docker / Dokploy)
# ---------------------------------------------------------------------------
PORT=8000
RUN_MIGRATIONS=true
RUN_SEED=true
RUN_STORAGE_LINK=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
